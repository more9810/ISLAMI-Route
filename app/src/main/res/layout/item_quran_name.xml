<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="10dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/imgNumVector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_num_vector"
        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        />
    <TextView
        android:id="@+id/tvSuraNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="99"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/imgNumVector"
        app:layout_constraintBottom_toBottomOf="@id/imgNumVector"
        app:layout_constraintStart_toStartOf="@id/imgNumVector"
        app:layout_constraintEnd_toEndOf="@id/imgNumVector"
        android:textColor="@color/white"/>

    <TextView
        android:id="@+id/tvSuraEnName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Al-Fatiha"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="@id/imgNumVector"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toEndOf="@id/imgNumVector"
        />
    <TextView
        android:id="@+id/tvVersesCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="7 Verses"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tvSuraEnName"
        app:layout_constraintStart_toStartOf="@id/tvSuraEnName"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvSuraArNem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/el_messiri_semi_bold"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="الفاتحه" />

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="36dp"
        android:layout_marginTop="16dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgNumVector"
        app:layout_constraintVertical_bias="0.0" />
</androidx.constraintlayout.widget.ConstraintLayout>